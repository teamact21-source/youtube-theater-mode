{
  "manifest_version": 3,
  "name": "YouTubeシアターモード",
  "version": "1.0.0",
  "description": "YouTubeの動画を開くと、自動でシアターモードに切り替えます。",
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
